RewriteEngine On

# API запросы — передаём PHP как есть
RewriteRule ^api/ - [L]

# Статические ассеты из dist/
RewriteRule ^assets/(.*)$ /dist/assets/$1 [L]

# Корневой путь — явно на dist/index.html
RewriteRule ^$ /dist/index.html [L]

# Для всех остальных маршрутов SPA — отдаём dist/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /dist/index.html [L]
